<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.tinect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/tinect</string>
    <string>up</string>
    <string>/etc/tinect/config.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Throttle respawns: without this an invalid config hot-loops. Rotate
       /var/log/tinect.log externally (newsyslog) to bound disk use. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/var/log/tinect.log</string>
  <key>StandardErrorPath</key><string>/var/log/tinect.log</string>
</dict>
</plist>
